PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?appName=<appName>
JWT_SECRET=<random 64-byte hex string, e.g. via `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`>
JWT_REFRESH_SECRET=<a different random 64-byte hex string, generated the same way>
